# Use the same repository for four separate Cloudflare Pages projects.
PUBLIC_SITE_ID=academy
# Enable only on your design-review project to browse all four identities.
PUBLIC_ENABLE_PREVIEWS=false
# Keep false until business details and privacy text are reviewed.
PUBLIC_INDEXABLE=false
# Optional real enquiry destinations. Never put API secrets in PUBLIC variables.
PUBLIC_CONTACT_EMAIL=
PUBLIC_WHATSAPP=
PUBLIC_INSTAGRAM=
PUBLIC_ADDRESS=
# Public viewing link of the uploaded Google Sheet. Server-only, no API key required.
# Leave empty to display bundled sample schedules and prices.
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
SHEETS_SPREADSHEET_URL=
